// Output configuration
// You can configure outputs by their name, which you can find
// by running `niri msg outputs` while inside a niri instance.
// The two laptops expose their built-in panels as eDP-1 and eDP-2 respectively.
// Find more information on the wiki:
// https://yalter.github.io/niri/Configuration:-Outputs

// Disable the built-in panel on the machine that exposes it as eDP-2.
output "eDP-2" {
    off
}

// Keep the built-in panel enabled on the machine that exposes it as eDP-1.
output "eDP-1" {
    mode "2160x1350@59.69"
    scale 1.3
    transform "normal"
    position x=1920 y=650
}

output "HDMI-A-1" {
    mode "1920x1080@199.997"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-2" {
    mode "1920x1080@199.997"
    scale 1
    transform "normal"
    position x=0 y=0
}
